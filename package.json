{
  "name": "baguni",
  "version": "1.4.11",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/redgoose-dev/baguni.git",
  "author": "redgoose <scripter@me.com>",
  "scripts": {
    "app:install": "bun run --bun resource/install.js",
    "app:uninstall": "bun run --bun resource/uninstall.js",
    "app:migrate-indexes": "bun run --bun tmp/migrate-add-indexes.js",
    "dev": "NODE_ENV=development concurrently \"bun run --bun server/main.js\" \"bunx --bun vite\"",
    "dev:server": "bun run --bun server/main.js",
    "prebuild": "rm -rf ./dist",
    "build": "bun run --bun ./server/build.js && bunx --bun vite build",
    "preview": "bun run --bun dist/main.js",
    "preview:server": "bun run --bun dist/main.js",
    "version-patch": "npm version patch",
    "build:test": "rm -rf ./dist/chunk && rm ./dist/main.js && bun run --bun ./server/build.js && bun run preview",
    "test": "bun test tests/"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "dependencies": {
    "@types/bun": "latest",
    "bcryptjs": "^3.0.3",
    "image-size": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "minimist": "^1.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@lucide/vue": "^1.70.0",
    "@redgoose/json-editor": "^1.2.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.7",
    "image-resize": "^1.4.1",
    "marked": "^18.1.3",
    "ofetch": "^1.5.1",
    "pinia": "^4.1.0",
    "sass": "^1.108.1",
    "terser": "^5.51.2",
    "vite": "^8.3.6",
    "vue": "^3.5.45",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^5.4.0"
  }
}
